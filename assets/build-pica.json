{
  "schema": "pica-ci-job-v1",
  "mgr": "pica",
  "id": "NAME",
  "enabled": true,
  "manifest": "src/pica/NAME/manifest",
  "source": {
    "provider": "tarball",
    "url_template": "https://github.com/OWNER/REPO/releases/download/VER/name-linux-{arch}.tar.gz",
    "strip_components": 1,
    "dest_subdir": "usr/sbin",
    "include": ["binary", "binary.toml", "LICENSE"],
    "arch_map": {
      "x86_64": "amd64",
      "aarch64_generic": "arm64",
      "aarch64_cortex-a53": "arm64",
      "aarch64_cortex-a72": "arm64"
    }
  },
  "versioning": {
    "pkgver": { "from": "manifest", "fallback": "0.0.0" },
    "pkgrel": { "from": "manifest", "fallback": 1 }
  },
  "build": {
    "matrix": [
      { "platform": "amd64", "arch": "x86_64" },
      { "platform": "arm64", "arch": "aarch64_generic" },
      { "platform": "arm64", "arch": "aarch64_cortex-a53" },
      { "platform": "arm64", "arch": "aarch64_cortex-a72" }
    ],
    "include_dirs": ["scripts", "root"],
    "pack": { "tool": "pica-pack", "format": "pkg.tar.gz" }
  },
  "publish": {
    "registry_db": "r/pica/NAME/db.json",
    "keep_release_history": 1
  }
}
